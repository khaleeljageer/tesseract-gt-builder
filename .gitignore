# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# PyPI configuration file
.pypirc
.idea/misc.xml

# Generated files
*.tif
*.gt.txt
tmp/
gt/
data/merged_output.txt

# Experiment outputs. Ablation sweeps write multi-GB of rendered crops,
# models and predictions; exclude the bulk but keep the record --
# result.json, journal.jsonl, manifests and code snapshots are small and
# are what makes a sweep reconstructible.
results/**/gt/
results/**/gt_pages/
results/**/pred/
results/**/model/
results/**/tessdata/
results/**/corpus.txt
results/**/*.tif
results/**/*.traineddata
results/**/*.log
# ...but keep the headline model's training log: the paper reports its
# error curve and wall-clock, and it is the only record of them.
!results/training/*.log
# The dictionary-less build is one arm of the DAWG comparison in the paper;
# keep it alongside the log rather than only the combined model.
!results/training/*.traineddata
gt_pages/

# Test-set candidate pool: 160MB of line crops, rebuildable from the source
# scans with `make_testset.py segment`. The drawn sample IS committed.
tesseract-gt-builder/testset/pool/
testset/pool/

# The real-document test set is the exception to the rules above. Those
# exclude the ~200k synthetic training crops, which regenerate from a seed;
# these 300 line images are captures of real pages and their transcriptions
# are typed by hand. Neither can be reconstructed, so both are committed.
!testset/images/
!testset/images/*.tif
!testset/gt/
!testset/gt/*.gt.txt
!testset/gt_prefill/
!testset/gt_prefill/*.gt.txt

# Source page scans for the test set: 164MB of photographed and scanned
# pages of published books, newspapers and government documents. The 300
# line crops drawn from them are committed; the full pages are not, both for
# size and because redistributing whole pages is a different question from
# quoting lines of them for evaluation. Back these up outside git.
raw_scans/

# Timestamped safety copies of hand transcriptions. Keep them locally; the
# authoritative set is testset/gt.
.transcription-backup-*/

# Keep the unicharset normalisation report; it is evidence for the
# corpus-hygiene section, not a build artefact.
!logs/unicharset_normalisation_v3.log

# Per-checkpoint predictions are derived from results/*.json; regenerate
# with make_testset.py predict rather than storing 14 x 300 files.
testset/preds_i*/
testset/preds_*/
experiment_log.md
